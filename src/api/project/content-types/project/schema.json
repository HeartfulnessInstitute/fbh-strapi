{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "archetype": {
      "type": "enumeration",
      "enum": [
        "Afforestation",
        "Biodiversity Restoration",
        "Lake Rejuvenation"
      ]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "video_thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "video_url": {
      "type": "string"
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "map_code": {
      "type": "text",
      "required": false
    },
    "species": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::specie.specie",
      "inversedBy": "projects"
    },
    "project_updates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project-update.project-update",
      "mappedBy": "project"
    },
    "trees": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tree.tree",
      "mappedBy": "project"
    },
    "tree_counts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tree-count.tree-count",
      "mappedBy": "project"
    },
    "deleted": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "order": {
      "type": "integer"
    }
  }
}
