{
  "kind": "collectionType",
  "collectionName": "attributes",
  "info": {
    "singularName": "attribute",
    "pluralName": "attributes",
    "displayName": "Attribute"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "Cause",
      "enum": [
        "Reason",
        "Cause",
        "Campaign"
      ]
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "order": {
      "type": "integer"
    }
  }
}
